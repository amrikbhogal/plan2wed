# Export this variable in your shell or deployment environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# SMTP settings: put real credentials only in /etc/plan2wed.env on the server.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=replace-on-server-only
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL="Plan2Wed <info@plan2wed.co.uk>"
SIGNUP_NOTIFICATION_EMAILS=info@plan2wed.co.uk
PLAN2WED_SITE_URL=https://plan2wed.co.uk
